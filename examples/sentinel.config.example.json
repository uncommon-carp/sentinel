{
  "target": {
    "baseUrl": "https://api.example.com",
    "openapi": "./openapi.json"
  },
  "auth": {
    "type": "none",
    "probePaths": [
      "/"
    ],
    "compareUnauthed": true
  },
  "suites": {
    "headers": true,
    "cors": true,
    "auth": true,
    "ratelimit": true,
    "injection": false
  },
  "scope": {
    "enabled": false,
    "methods": [
      "get",
      "head"
    ],
    "maxEndpoints": 20,
    "includePaths": [],
    "excludePaths": [],
    "prefer": [
      "^/health",
      "^/status",
      "^/me",
      "^/api/health"
    ]
  },
  "injection": {
    "categories": [
      "sql",
      "nosql",
      "template"
    ],
    "paramTypes": [
      "query",
      "body"
    ]
  },
  "active": {
    "maxRequestsPerSuite": 40,
    "timeoutMs": 8000
  },
  "output": {
    "dir": "./sentinel-out",
    "json": true,
    "markdown": true
  },
  "verbose": false
}
